# Copiá este archivo a `deploy.env` y completalo con los datos de tu servidor.
# `deploy.env` está en .gitignore: no se versiona ni se comparte.

# Alias del host en ~/.ssh/config
SSH_ALIAS=mi-servidor

# ── Producción (./deploy.sh) ────────────────────────────────────────────────
# Directorio en el servidor: tiene que ser un clon git de este repo, en main.
REMOTE_DIR=/var/www/mi-sitio/generador
PUBLIC_URL=https://ejemplo.com/generador/

# ── Vista previa (./deploy.sh preview) ──────────────────────────────────────
# Segundo clon del repo, para publicar una rama sin tocar producción. Se crea
# una sola vez, y después el script lo mantiene al día:
#
#   ssh mi-servidor 'git clone -b mi-rama git@github.com:usuario/repo.git /var/www/mi-sitio/generador-preview'
#
# Además hay que servirlo: en nginx, un `location` con `alias` a ese directorio.
PREVIEW_DIR=/var/www/mi-sitio/generador-preview
PREVIEW_URL=https://ejemplo.com/generador-preview/
