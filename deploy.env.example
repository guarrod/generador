# Copiá este archivo a `deploy.env` y completalo con los datos de tu servidor.
# `deploy.env` está en .gitignore: no se versiona ni se comparte.

# Alias del host en ~/.ssh/config
SSH_ALIAS=mi-servidor

# Directorio en el servidor: tiene que ser un clon git de este repo
REMOTE_DIR=/var/www/mi-sitio/generador

# Solo para el mensaje final del script
PUBLIC_URL=https://ejemplo.com/generador/
